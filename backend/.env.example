HOST=127.0.0.1
PORT=3000
# Thêm URL Vercel thực tế vào danh sách này sau khi deploy FE.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://demo.artium.id.vn

# EC2 dùng IAM role; không thêm access key vào repo hoặc frontend.
AWS_REGION=ap-southeast-1
S3_BUCKET=artium-cloud-demo-thinh-20261005
# API công khai chỉ đọc demo/; đặt file mẫu có thể chia sẻ trong prefix này.

# Mã riêng cho SNS/SES/EFS/Lex; tạo bằng: openssl rand -hex 32
# Không commit mã thật. Nhập mã vào ô password trên web khi demo.
DEMO_WRITE_TOKEN=
SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-1:461508717285:artium-cloud-demo-alerts

# SES chưa thực hành: để sender trống đến khi verify email trong đúng region.
SES_REGION=ap-southeast-1
SES_FROM_EMAIL=
SES_TO_EMAIL=vanthinh.dev@gmail.com

# Thư mục trên EFS đã mount, thuộc user ubuntu; chỉ dùng file web-demo.txt.
EFS_DIRECTORY=/mnt/efs-demo/thinh
LEX_BOT_ID=JHDVF8HBVM
LEX_BOT_ALIAS_ID=TSTALIASID
LEX_LOCALE_ID=en_US
