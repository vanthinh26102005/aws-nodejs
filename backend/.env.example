HOST=127.0.0.1
PORT=3000
# Thêm URL Vercel thực tế vào danh sách này sau khi deploy FE.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://demo.artium.id.vn

# EC2 dùng IAM role; không thêm access key vào repo hoặc frontend.
AWS_REGION=ap-southeast-1
S3_BUCKET=artium-cloud-demo-thinh-20261005
# API công khai chỉ đọc demo/; đặt file mẫu có thể chia sẻ trong prefix này.
